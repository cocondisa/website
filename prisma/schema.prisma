// Schéma Prisma — gestion des créneaux et réservations pour le bain enveloppé.
// Les créneaux sont gérés par Isabelle via l'espace /admin (protégé par mot
// de passe). Les réservations sont payées intégralement via Stripe Checkout :
// une réservation EN_ATTENTE_PAIEMENT retient le créneau le temps du
// paiement, puis passe à CONFIRMEE (webhook Stripe) ou est libérée si le
// paiement expire/échoue.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connexion "pooled" (Supavisor/PgBouncer) — utilisée à l'exécution (serverless)
  directUrl = env("DIRECT_URL") // connexion directe — utilisée par `prisma migrate` / `db push`
}

enum StatutReservation {
  EN_ATTENTE_PAIEMENT
  CONFIRMEE
  ANNULEE
}

enum OrigineCreneau {
  AUTO // généré depuis les disponibilités récurrentes
  MANUEL // ajouté à la main par Isabelle depuis l'admin
}

model Creneau {
  id           String         @id @default(cuid())
  date         DateTime // date et heure de début du créneau
  dureeMinutes Int            @default(60)
  disponible   Boolean        @default(true)
  origine      OrigineCreneau @default(MANUEL)
  reservation  Reservation?
  createdAt    DateTime       @default(now())

  @@index([date])
}

model Reservation {
  id              String            @id @default(cuid())
  creneau         Creneau           @relation(fields: [creneauId], references: [id])
  creneauId       String            @unique
  nomComplet      String
  email           String
  telephone       String
  infosBebe       String?
  message         String?
  statut          StatutReservation @default(EN_ATTENTE_PAIEMENT)
  stripeSessionId String?           @unique
  expiresAt       DateTime? // retenue expirée = créneau libérable si le paiement n'a pas abouti
  createdAt       DateTime          @default(now())
}

// Périodes de vacances / jours off d'Isabelle : masquent automatiquement les
// créneaux qui y tombent, sans avoir à les supprimer un par un.
model Vacances {
  id        String   @id @default(cuid())
  debut     DateTime // 00:00 du premier jour
  fin       DateTime // 23:59:59 du dernier jour
  label     String?
  createdAt DateTime @default(now())

  @@index([debut, fin])
}

// Ligne unique (id fixe "default") pour les réglages globaux du site :
// bandeau d'annonce affichable/masquable par Isabelle depuis l'admin.
model Parametres {
  id             String  @id @default("default")
  bandeauActif   Boolean @default(false)
  bandeauMessage String  @default("")
}

// Ligne unique (id fixe "default") : disponibilités récurrentes d'Isabelle,
// utilisées pour générer automatiquement les créneaux à venir. Chaque jour
// est scindé en matin/après-midi pour permettre des demi-journées off.
model Disponibilite {
  id                String  @id @default("default")
  lundiMatin        Boolean @default(true)
  lundiApresMidi    Boolean @default(true)
  mardiMatin        Boolean @default(true)
  mardiApresMidi    Boolean @default(true)
  mercrediMatin     Boolean @default(true)
  mercrediApresMidi Boolean @default(true)
  jeudiMatin        Boolean @default(true)
  jeudiApresMidi    Boolean @default(true)
  vendrediMatin     Boolean @default(true)
  vendrediApresMidi Boolean @default(true)
  samediMatin       Boolean @default(false)
  samediApresMidi   Boolean @default(false)
  dimancheMatin     Boolean @default(false)
  dimancheApresMidi Boolean @default(false)

  heureDebut          String @default("09:00") // format "HH:mm", heure de Paris
  heureMidi           String @default("13:00") // fin de matinée / début d'après-midi
  heureFin            String @default("17:00")
  dureeCreneauMinutes Int    @default(90)
  maxRdvParJour       Int    @default(4)
}
