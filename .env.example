RESEND_API_KEY=
NOTIFICATION_EMAIL=          # e-mail d'Isabelle qui reçoit les notifications de RDV

# Supabase (Project Settings > Database > Connection string) :
# - DATABASE_URL : connexion "Transaction pooler" (port 6543), utilisée à l'exécution
#   (Next.js / serverless). Doit inclure "?pgbouncer=true".
# - DIRECT_URL   : connexion directe (port 5432), utilisée uniquement par
#   `prisma migrate` / `prisma db seed`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Espace admin (/admin) — mot de passe unique partagé, protège la gestion des créneaux.
ADMIN_PASSWORD=

# Stripe (Dashboard > Developers > API keys / Webhooks) :
# - STRIPE_SECRET_KEY    : clé secrète (sk_test_... en développement, sk_live_... en prod).
# - STRIPE_PRICE_ID      : ID du Price Stripe pour "Le bain enveloppé" (price_...).
#   À mettre à jour quand le tarif passe de 100 € à 150 € (créer un nouveau Price).
# - STRIPE_WEBHOOK_SECRET : signature du webhook (whsec_...), voir `stripe listen` en local
#   ou Dashboard > Developers > Webhooks en production.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
